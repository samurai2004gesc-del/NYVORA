# Copia este archivo a .env.local (en tu compu) o pon estas variables en
# Vercel → Project → Settings → Environment Variables.
# Basta con UNA clave de IA. Con las dos, el estudio deja elegir el motor
# y comparar. Sin ninguna, el estudio funciona en modo demo.

# Google Gemini → Nano Banana Pro (gemini-3-pro-image). El más fiel en fotorrealismo.
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3-pro-image

# OpenAI → GPT Image 2 (gpt-image-2)
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2

# Motor por defecto si pones las dos claves: gemini | openai
# NYVORA_IMAGE_PROVIDER=gemini

# Recomendado en producción: código que hay que escribir en el estudio para
# generar imágenes. Evita que desconocidos gasten tus créditos de IA.
NYVORA_ACCESS_CODE=
