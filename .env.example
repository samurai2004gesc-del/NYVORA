# Copia este archivo a .env.local (en tu compu) o pon estas variables en
# Vercel → Project → Settings → Environment Variables.
# Basta con UNA de las dos claves de IA. Sin ninguna, el estudio funciona en modo demo.

# Opción A — OpenAI (modelo de imagen gpt-image-1 por defecto)
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# Opción B — Google Gemini (modelo "Nano Banana" por defecto)
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Si pones las dos claves, elige cuál usar: openai | gemini
# NYVORA_IMAGE_PROVIDER=openai

# Recomendado en producción: código que hay que escribir en el estudio para
# generar imágenes. Evita que desconocidos gasten tus créditos de IA.
NYVORA_ACCESS_CODE=
